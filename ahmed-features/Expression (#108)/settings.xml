<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.knime.org/2008/09/XMLConfig" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.knime.org/2008/09/XMLConfig http://www.knime.org/XMLConfig_2008_09.xsd" key="settings.xml">
    <entry key="node_file" type="xstring" value="settings.xml"/>
    <config key="flow_stack"/>
    <config key="internal_node_subsettings">
        <entry key="memory_policy" type="xstring" value="CacheSmallInMemory"/>
    </config>
    <config key="model">
        <entry key="script" type="xstring" value="join(&quot;&quot;, &quot; &quot;, if($[&quot;tags&quot;] == MISSING, &quot;&quot;, string($[&quot;tags&quot;])), &quot; &quot;)"/>
        <entry key="columnOutputMode" type="xstring" value="APPEND"/>
        <entry key="createdColumn" type="xstring" value="tags_padded"/>
        <entry key="replacedColumn" type="xstring" value="New Column"/>
        <entry key="languageVersion" type="xint" value="1"/>
        <entry key="builtinFunctionsVersion" type="xint" value="1"/>
        <entry key="builtinAggregationsVersion" type="xint" value="1"/>
        <config key="additionalExpressions">
            <config key="0">
                <entry key="script" type="xstring" value="if($[&quot;eventName&quot;] == &quot;Shot&quot; OR $[&quot;subEventName&quot;] == &quot;Free kick shot&quot; OR $[&quot;subEventName&quot;] == &quot;Penalty&quot;, 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_is_shot"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="1">
                <entry key="script" type="xstring" value="1"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_events"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="2">
                <entry key="script" type="xstring" value="$[&quot;wy_is_shot&quot;]"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_shots"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="3">
                <entry key="script" type="xstring" value="if($[&quot;wy_is_shot&quot;] == 1 AND contains($[&quot;tags_padded&quot;], &quot; 1801 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_shots_on_target"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="4">
                <entry key="script" type="xstring" value="if($[&quot;wy_is_shot&quot;] == 1 AND contains($[&quot;tags_padded&quot;], &quot; 101 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_goals"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="5">
                <entry key="script" type="xstring" value="if(contains($[&quot;tags_padded&quot;], &quot; 301 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_assists"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="6">
                <entry key="script" type="xstring" value="if(contains($[&quot;tags_padded&quot;], &quot; 302 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_key_passes"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="7">
                <entry key="script" type="xstring" value="if($[&quot;eventName&quot;] == &quot;Pass&quot;, 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_passes"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="8">
                <entry key="script" type="xstring" value="if($[&quot;eventName&quot;] == &quot;Pass&quot; AND contains($[&quot;tags_padded&quot;], &quot; 1801 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_passes_accurate"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="9">
                <entry key="script" type="xstring" value="if($[&quot;eventName&quot;] == &quot;Duel&quot;, 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_duels"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="10">
                <entry key="script" type="xstring" value="if($[&quot;eventName&quot;] == &quot;Duel&quot; AND contains($[&quot;tags_padded&quot;], &quot; 703 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_duels_won"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="11">
                <entry key="script" type="xstring" value="if(contains($[&quot;tags_padded&quot;], &quot; 1401 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_interceptions"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="12">
                <entry key="script" type="xstring" value="if($[&quot;subEventName&quot;] == &quot;Clearance&quot;, 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_clearances"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
            <config key="13">
                <entry key="script" type="xstring" value="if(contains($[&quot;tags_padded&quot;], &quot; 1702 &quot;), 1, 0)"/>
                <entry key="columnOutputMode" type="xstring" value="APPEND"/>
                <entry key="createdColumn" type="xstring" value="wy_yellow_cards"/>
                <entry key="replacedColumn" type="xstring" value="New Column"/>
            </config>
        </config>
    </config>
